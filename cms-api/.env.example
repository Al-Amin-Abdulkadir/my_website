# Copy to cms-api/.env for local development. On Vercel, set these in the
# project's Environment Variables instead — never commit real values.
DATABASE_URL=postgresql://user:password@host:5432/portfolio_cms
SECRET_KEY=your-long-random-secret-key-here
# The editor login lives in the database — set it with:  python -m app.set_admin_password

# Password-reset emails (resend.com, free). Without a key, local development prints
# the reset code in the API's terminal; the live site needs the key.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Portfolio CMS <onboarding@resend.dev>

# Cloudinary (Settings → API Keys). Needed for uploading photos and videos.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
